<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HeicViewer</RootNamespace>
    <AssemblyName>HeicViewer</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>HEIC Viewer</Product>
    <Description>Zoom/pan image viewer for HEIC, HEIF, HIF and AVIF with a built-in decoder — no paid codec needed.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Magick.NET bundles libheif + libde265: decodes every HEIC/HEIF/HIF/AVIF without
         requiring Windows' paid HEVC extension. Q8 is fast and plenty for on-screen viewing. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.*" />
  </ItemGroup>

</Project>
